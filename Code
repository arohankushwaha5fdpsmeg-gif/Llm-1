MEMORY_FILE = "/content/brain_memory.json"

def load_memory():
    if os.path.exists(MEMORY_FILE):
      with open(MEMORY_FILE, 'r') as f:
        return json.load(f)
    return {
        "user_name": "Companion",
        "emotional_notes": "First initialization. Building a collaborative relationship.",
        "project_milestones": [],
        "chat_history": []
                                                                }

def save_memory(memory_data):
  with open(MEMORY_FILE, 'w') as f:
    json.dump(memory_data, f, indent=4)
